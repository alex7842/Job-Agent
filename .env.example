# Copy to .env at the repository root. Every app in the workspace reads this one
# file (apps/job-agent/src/env.ts resolves it, Vite reads it for the dev proxy).
# Never prefix a secret with VITE_ — anything VITE_ ships to the browser bundle.

# ---------- database ----------
# Port 5433 is what docker-compose.yml publishes; use 5432 if you run your own
# Postgres on the default port.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=task_app
# Dev convenience: TypeORM syncs the schema on boot. In production run
# `pnpm --filter job-agent migration:run` and set this to false.
DB_SYNC=true

# ---------- api ----------
PORT=3000
# Dev-only target for the Vite proxy (vite.config.ts). Leave unset to use :3000.
# API_URL=http://localhost:3000

# ---------- auth ----------
# REQUIRED. The API refuses to boot without it, so a missing secret can never
# fall back to a shared default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access tokens are short-lived and held in memory/sessionStorage; refresh tokens
# are revocable rows in the database.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- kafka ----------
KAFKA_BROKERS=localhost:9092

# ---------- temporal ----------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Daily search schedule. The worker registers this on boot (idempotently).
SCHEDULE_CRON=0 10 * * *
SCHEDULE_TIMEZONE=Asia/Kolkata

# ---------- llm scoring (gemini) ----------
# The same key scores postings and builds embeddings. Without it the
# jobs.raw -> jobs.new stage still works; scoring errors are stored on the row
# and retried from the UI with "Rescore", and embeddings fall back to the
# offline provider, which is lexical rather than semantic.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.1-flash-lite is the stable cheap tier; gemini-3.8-flash reasons
# better at roughly 5x the input price.
GEMINI_SCORING_MODEL=gemini-3.1-flash-lite

# ---------- job sources ----------
# A source whose credentials are missing is skipped automatically.
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ---------- rag service (apps/rag-service) ----------
# Every adapter below falls back to a local, no-credential implementation, so
# the whole flow runs with this section left empty. The service logs a DEGRADED
# warning on boot and reports "degraded": true in every search response, which
# is how you tell a lexical-only result set from a real semantic one.

# RAG_PORT=3001

# Required in production. The job agent signs each internal request with this
# secret; the RAG service refuses to boot if it is missing or under 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# RAG_INTERNAL_SECRET=

# Embeddings. Gemini is the default as soon as the GEMINI_API_KEY above is set
# (free tier, gemini-embedding-001, 1536 dims) — one key covers scoring and
# vectors. `offline` is the only other provider needed: it is deterministic and
# credential-free, which is what tests and offline development use. The Pinecone
# index dimension MUST match the provider: 1536 for gemini, 384 for offline.
# EMBEDDING_PROVIDER=gemini

# Vector store. Defaults to pinecone when PINECONE_API_KEY is set, else memory.
# The memory store is per-process and lost on restart: fine for development,
# not for production.
# VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX=job-agent
# 1536 for gemini-embedding-001, 1024 for voyage-3, 768 for nomic-embed-text.
# PINECONE_DIMENSIONS=1536

# Object storage. Defaults to s3 when S3_BUCKET is set, else a local directory.
# Uploads go browser -> bucket via a presigned URL, so document bytes never pass
# through the API process.
# OBJECT_STORE=s3
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For MinIO / LocalStack only:
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# LOCAL_STORAGE_DIR=./.local-storage

# Kafka consumer group for the indexing events. All replicas sharing a group
# share the work; a different value starts a second, independent consumer.
# RAG_KAFKA_GROUP=rag-service

# How long a presigned PUT stays valid. Enforced as a number, so an unparsable
# value falls back to 900s rather than breaking the signature.
# RAG_PRESIGN_TTL_SECONDS=900

# Candidate depth for search: how many vectors each query pulls, and how many
# per query are treated as evidence when fusing. Raising these sharpens recall
# and costs latency.
# RAG_MAX_CANDIDATES=50
# RAG_MATCH_DEPTH=10

# ---------- job agent: retrieval (apps/job-agent) ----------
# The API needs these to upload documents and compute semantic scores. Leave
# RAG_INTERNAL_SECRET empty and everything else still works: uploads are
# refused with a clear message and jobs get a score but no semantic score.

# RAG_SERVICE_URL=http://localhost:3001
# RAG_INTERNAL_SECRET= (same value as the RAG service's)

# Per-request timeout for internal RAG calls, in ms. A call that exceeds it
# returns null, which callers treat as "retrieval unavailable", never as an
# error in the request.
# RAG_REQUEST_TIMEOUT_MS=15000

# How many postings a run's semantic pass asks for.
# RAG_SEARCH_TOP_K=20

# How long a run's workflow waits for its postings to reach the database before
# ranking them, in ms. Best effort: on expiry the run ranks what has arrived.
# RAG_DRAIN_WAIT_MS=45000

# Pause between retries when a run has postings but the vector store returns
# nothing yet, in ms.
# RAG_EMPTY_SEARCH_RETRY_MS=2000
