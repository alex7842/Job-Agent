# Copy to .env at the repository root. Every app in the workspace reads this one
# file (apps/job-agent/src/env.ts resolves it, Vite reads it for the dev proxy).
# Never prefix a secret with VITE_ — anything VITE_ ships to the browser bundle.

# ---------- database ----------
# Port 5433 is what docker-compose.yml publishes; use 5432 if you run your own
# Postgres on the default port.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=job_agent
# Dev convenience: TypeORM syncs the schema on boot. In production run
# `pnpm --filter job-agent migration:run` and set this to false.
DB_SYNC=true

# ---------- api ----------
PORT=3000
# Dev-only target for the Vite proxy (vite.config.ts). Leave unset to use :3000.
# API_URL=http://localhost:3000

# ---------- auth ----------
# REQUIRED. The API refuses to boot without it, so a missing secret can never
# fall back to a shared default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access tokens are short-lived and held in memory/sessionStorage; refresh tokens
# are revocable rows in the database.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Admin dashboard: GET /admin/overview and the /admin page in the web app.
# Comma-separated emails; anyone else signed in gets a 403 from the API, so
# hiding the link in the UI is convenience rather than the control. Blank denies
# everyone — fail closed, because the alternative is an open admin API. Read per
# request, not baked into the token, so a revocation is immediate.
# ADMIN_EMAILS=you@example.com

# ---------- kafka ----------
KAFKA_BROKERS=localhost:9092

# ---------- temporal ----------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Daily search schedule. The worker registers this on boot (idempotently).
SCHEDULE_CRON=0 10 * * *
SCHEDULE_TIMEZONE=Asia/Kolkata

# ---------- llm scoring ----------
# SCORING_PROVIDER picks the descriptor in packages/ai/src/providers.ts:
# openrouter | nvidia | mistral | ollama | openai-compatible. It also drives
# resume parsing, so one key covers both. Without a key the jobs.raw ->
# jobs.new stage still works; scoring errors are stored on the row and retried
# from the UI with "Rescore", and embeddings fall back to the offline provider,
# which is lexical rather than semantic.
SCORING_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys. The ":free" models cost nothing but
# are capped at a few requests per model per day and are frequently 429'd
# upstream, so bulk rescoring will hit the quota and scoreError those rows.
# The layer retries 429s with backoff, which absorbs short limits.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models works. Blank uses the provider
# default, nvidia/nemotron-3-super-120b-a12b:free — the free model that
# reliably honours response_format json_schema, which the scorer depends on.
# Paid alternatives that also support structured output:
# qwen/qwen3-235b-a22b, meta-llama/llama-3.3-70b-instruct.
SCORING_MODEL=
# Same provider and key; blank follows SCORING_MODEL's model. A resume is a
# much longer input than a posting, so it gets its own override only if the
# cheaper model starts truncating.
RESUME_PARSING_MODEL=

# Fallback provider, consulted only when the primary cannot serve a request:
# 429 rate limited, 402 out of quota (what an exhausted free allowance returns),
# or 5xx. A 401/403 or a 400 does NOT fail over — a wrong key or a malformed
# request would get the same answer from any provider, so those cost the
# fallback nothing and surface as a real error instead.
#
# After a failover the primary is parked for a minute so the rest of a run goes
# straight to the working provider rather than paying the 429 backoff on every
# row; it is retried after that, so a recovered primary comes back on its own.
#
# nvidia serves the *same weights* as the OpenRouter default
# (nvidia/nemotron-3-super-120b-a12b), so a failover changes latency and nothing
# else. The two quotas are independent, which is the point: OpenRouter running
# out no longer stops scoring. Key: https://build.nvidia.com — free developer
# credits with it.
SCORING_FALLBACK_PROVIDER=
# Blank uses the fallback provider's own default model.
SCORING_FALLBACK_MODEL=
# NVIDIA_API_KEY=

# ---------- job sources ----------
# A source whose credentials are missing is skipped automatically.
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ---------- rag service (apps/rag-service) ----------
# Every adapter below falls back to a local, no-credential implementation, so
# the whole flow runs with this section left empty. The service logs a DEGRADED
# warning on boot and reports "degraded": true in every search response, which
# is how you tell a lexical-only result set from a real semantic one.

# RAG_PORT=3001

# Required in production. The job agent signs each internal request with this
# secret; the RAG service refuses to boot if it is missing or under 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# RAG_INTERNAL_SECRET=

# Embeddings. OpenRouter is the default as soon as the OPENROUTER_API_KEY above
# is set (openai/text-embedding-3-small, about $0.02/1M tokens) — the same key as
# scoring, so one credential covers the whole pipeline. Unlike the ":free" chat
# models, embeddings are billed. `offline` is the credential-free option: it is
# deterministic, which is what tests and offline development use, but it is
# lexical rather than semantic. The Pinecone index dimension MUST match the
# provider: 1024 for openrouter/mistral, 384 for offline.
# EMBEDDING_PROVIDER=openrouter
# text-embedding-3-small is natively 1536d and accepts a `dimensions`
# truncation. Changing model or width invalidates every stored vector: the
# Pinecone index has to be re-created and re-indexed.
# EMBEDDING_DIMENSIONS=1024

# Vector store. Defaults to pinecone when PINECONE_API_KEY is set, else memory.
# The memory store is per-process and lost on restart: fine for development,
# not for production.
# VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX=job-agent
# 1024 for openrouter/mistral, 384 for offline.
# PINECONE_DIMENSIONS=1024

# Object storage. Defaults to s3 when S3_BUCKET is set, else a local directory.
# Uploads go browser -> bucket via a presigned URL, so document bytes never pass
# through the API process.
# OBJECT_STORE=s3
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For MinIO / LocalStack only:
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# LOCAL_STORAGE_DIR=./.local-storage

# Kafka consumer group for the indexing events. All replicas sharing a group
# share the work; a different value starts a second, independent consumer.
# RAG_KAFKA_GROUP=rag-service

# How long a presigned PUT stays valid. Enforced as a number, so an unparsable
# value falls back to 900s rather than breaking the signature.
# RAG_PRESIGN_TTL_SECONDS=900

# Candidate depth for search: how many vectors each query pulls, and how many
# per query are treated as evidence when fusing. Raising these sharpens recall
# and costs latency.
# RAG_MAX_CANDIDATES=50
# RAG_MATCH_DEPTH=10

# ---------- job agent: retrieval (apps/job-agent) ----------
# The API needs these to upload documents and compute semantic scores. Leave
# RAG_INTERNAL_SECRET empty and everything else still works: uploads are
# refused with a clear message and jobs get a score but no semantic score.

# RAG_SERVICE_URL=http://localhost:3001
# RAG_INTERNAL_SECRET= (same value as the RAG service's)

# Per-request timeout for internal RAG calls, in ms. A call that exceeds it
# returns null, which callers treat as "retrieval unavailable", never as an
# error in the request.
# RAG_REQUEST_TIMEOUT_MS=15000

# How many postings a run's semantic pass asks for.
# RAG_SEARCH_TOP_K=20

# How long a run's workflow waits for its postings to reach the database before
# ranking them, in ms. Best effort: on expiry the run ranks what has arrived.
# RAG_DRAIN_WAIT_MS=45000

# Pause between retries when a run has postings but the vector store returns
# nothing yet, in ms.
# RAG_EMPTY_SEARCH_RETRY_MS=2000
