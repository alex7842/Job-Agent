# compiled output
dist/
build/
.turbo/

# dependencies
node_modules/
.pnpm-store/

# TypeScript build cache
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files (the single root .env is shared by every app)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
!.env.example

# temp directory
.temp
.tmp

# Local object store for the RAG service (see LOCAL_STORAGE_DIR in .env.example).
# User-uploaded documents land here when no S3 bucket is configured.
.local-storage/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
